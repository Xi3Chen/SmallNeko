.venv/
__pycache__/
*.py[cod]

# Generated training outputs
stages/*/experiments/*
!stages/*/experiments/.gitkeep
stages/*/data/downloads/*
!stages/*/data/downloads/.gitkeep

# Local datasets and generated preprocessing artifacts
stages/*/data/raw/*
!stages/*/data/raw/.gitkeep
stages/*/data/processed/*
!stages/*/data/processed/.gitkeep
